# Trading Agent v0.1 — environment. Copy to .env (git-ignored) to override.

# Where the app binds. Keep 127.0.0.1: the app is local-only.
TA_HOST=127.0.0.1
TA_PORT=8000

# SQLite database and data directory (exports, backups).
TA_DB_PATH=data/agent.db
TA_DATA_DIR=data/

# Market data source: bitvavo (public API) or sim (deterministic simulated market).
TA_DATA_SOURCE=bitvavo

# Optional fallback for the OpenAI key when the OS keyring has none.
# Secrets never land in the database, logs or API responses.
# OPENAI_API_KEY=
